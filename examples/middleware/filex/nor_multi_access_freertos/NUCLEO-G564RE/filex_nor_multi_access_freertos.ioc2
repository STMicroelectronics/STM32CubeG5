"File: filex_nor_multi_access_freertos.csolution.yml" = """
# yaml-language-server: $schema=https://raw.githubusercontent.com/Open-CMSIS-Pack/devtools/schemas/projmgr/2.11.0/tools/projmgr/schemas/csolution.schema.json
solution:
  target-types:
    - type: NUCLEO-G564RE
      board: NUCLEO-G564RE:NUG564RE$CR1
      device: STM32G564RET3
  output-dirs:
    tmpdir: build/tmp
    outdir: $SolutionDir()$/build/$Project$.$BuildType$
  generators:
    base-dir: $ProjectDir()$/generated
    options:
      - generator: stm32g5xx_hal_mx2codegen
        path: $SolutionDir()$/../generated/hal/
      - generator: syscalls_mx2codegen
        path: $SolutionDir()$/../generated/utilities/syscalls
      - generator: w25q128j_mx2codegen
        path: $SolutionDir()$/../generated/parts/w25q128j
      - generator: filex_mx2codegen
        path: $SolutionDir()$/../generated/middleware/filex
      - generator: levelx_mx2codegen
        path: $SolutionDir()$/../generated/middleware/levelx
      - generator: freertos_mx2codegen
        path: $SolutionDir()$/../generated/middleware/freertos
      - generator: basic_stdio_mx2codegen
        path: $SolutionDir()$/../generated/utilities/basic_stdio
  build-types:
    - type: debug_GCC
      compiler: GCC
    - type: release_GCC
      compiler: GCC
    - type: debug_IAR
      compiler: IAR
    - type: release_IAR
      compiler: IAR
    - type: debug_AC6
      compiler: AC6
    - type: release_AC6
      compiler: AC6
  projects:
    - project: project/filex_nor_multi_access_freertos.cproject.yml
  packs:
    - pack: STMicroelectronics::basic_stdio@2.1.0
    - pack: STMicroelectronics::button_hw-part@2.2.0
