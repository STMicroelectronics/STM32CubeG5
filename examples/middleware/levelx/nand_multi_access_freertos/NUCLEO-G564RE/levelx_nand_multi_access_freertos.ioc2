"File: levelx_nand_multi_access_freertos.csolution.yml" = """
# yaml-language-server: $schema=https://raw.githubusercontent.com/Open-CMSIS-Pack/devtools/schemas/projmgr/2.11.0/tools/projmgr/schemas/csolution.schema.json
solution:
  target-types:
    - type: NUCLEO-G564RE
      board: NUCLEO-G564RE:NUG564RE$CR1
      device: STM32G564RET3
  output-dirs:
    tmpdir: build/tmp
    outdir: $SolutionDir()$/build/$Project$.$BuildType$
  generators:
    base-dir: $ProjectDir()$/generated
    options:
      - generator: stm32g5xx_hal_mx2codegen
        path: $SolutionDir()$/../generated/hal/
      - generator: syscalls_mx2codegen
        path: $SolutionDir()$/../generated/utilities/syscalls
      - generator: w25n01gvxx_mx2codegen
        path: $SolutionDir()$/../generated/parts/w25n01gvxx
      - generator: levelx_mx2codegen
        path: $SolutionDir()$/../generated/middleware/levelx
      - generator: freertos_mx2codegen
        path: $SolutionDir()$/../generated/middleware/freertos
      - generator: basic_stdio_mx2codegen
        path: $SolutionDir()$/../generated/utilities/basic_stdio
  build-types:
    - type: debug_GCC
      compiler: GCC
    - type: release_GCC
      compiler: GCC
    - type: debug_IAR
      compiler: IAR
    - type: release_IAR
      compiler: IAR
    - type: debug_AC6
      compiler: AC6
    - type: release_AC6
      compiler: AC6
  projects:
    - project: project/levelx_nand_multi_access_freertos.cproject.yml
  packs:
    - pack: STMicroelectronics::basic_stdio@2.1.0
    - pack: STMicroelectronics::button_hw-part@2.2.0
    - pack: STMicroelectronics::CMSIS@6.3.0
    - pack: STMicroelectronics::crystal_hw-part@2.3.1
    - pack: STMicroelectronics::esd_hw-part@2.2.0
    - pack: STMicroelectronics::freertos@2.2.0
    - pack: STMicroelectronics::led_hw-part@2.5.0
    - pack: STMicroelectronics::levelx@2.2.0
    - pack: STMicroelectronics::mcp2562fd_hw-part@2.1.0
    - pack: STMicroelectronics::nucleo-g564re_hw-board@2.0.0
    - pack: STMicroelectronics::st-link_hw-part@2.1.0
    - pack: STMicroelectronics::stm32g5xx_dfp@2.0.0
    - pack: STMicroelectronics::stm32g5xx_hal_drivers@2.0.0
    - pack: STMicroelectronics::syscalls@2.0.2
    - pack: STMicroelectronics::w25n01gv_hw-part@2.2.0
    - pack: STMicroelectronics::w25n01gvxx_part_drivers@2.2.0
"""
