<package xmlns:xs="http://www.w3.org/2001/XMLSchema-instance" schemaVersion="1.0" xs:noNamespaceSchemaLocation="https://github.com/Open-CMSIS-Pack/Open-CMSIS-Pack-Spec/blob/main/schema/PACK.xsd">
  <vendor>STMicroelectronics</vendor>
  <name>stfcf</name>
  <url>https://developer.st.com/st-pack-server/api/v1/pack/</url>
  <releases>
    <release version="1.1.0" date="2026-07-24">
      - Optimize alternative file list generation
    </release>
    <release version="1.0.0" date="2026-04-20">
      - STFCF GPDSC Model Release
    </release>
  </releases>
  <description>STM32CubeMX2 Code Generation for STM32 Flexible Crypto Framework</description>
  <conditions>
    <condition id="PSA interface conditions">
    <description>Ensure PSA API are satisfied</description>
    <require Cclass="Security" Cgroup="MbedTLS" Csub="PSA API"/>
  </condition>
  <condition id="alt ecp condition">
    <description>Enable ecp_alt implementation</description>
    <accept Cclass="Security" Cgroup="STFCF" Csub="MbedTLS Alt STCryptoLib"/>
    <accept Cclass="Security" Cgroup="STFCF" Csub="MbedTLS Alt HAL"/>
  </condition>
    <condition id="STFCF config condition">
      <description>STFCF possible implementations</description>
      <deny Cclass="Security" Cgroup="STFCF" Csub="Core"/>
      <require Cclass="Security" Cgroup="STFCF" Csub="PSA API"/>
      <require Cclass="Security" Cgroup="STFCF" Csub="MbedTLS Alt Common"/>
      <require Cclass="Security" Cgroup="STFCF" Csub="MbedTLS Alt HAL"/>
      <require condition="Mbed TLS Alt HAL condition"/> 
    </condition>
    <condition id="Mbed TLS Alt STCryptoLib condition">
      <description>Requires STCryptoLib config component</description>
      <require Cclass="Security" Cgroup="STFCF" Csub="MbedTLS Alt Common"/>
      <require Cclass="Security" Cgroup="STCryptoLib" Csub="CMOX API"/>
      <require Cclass="Security" Cgroup="STM32CubeMX2 Config" Csub="STCryptoLib"/>
    </condition>
    <condition id="Mbed TLS Alt HAL condition">
      <description>Mbed TLS Alt HAL condition</description>
      <require Cclass="Security" Cgroup="STFCF" Csub="MbedTLS Alt Common"/>
      <require Cclass="Device" Cgroup="STM32CubeMX2 Config" Csub="RNG"/>
    </condition>
    <condition id="KWE condition">
      <description>Requires CCB HAL driver component</description>
      <require Cclass="Device" Cgroup="STM32CubeMX2 Config" Csub="CCB"/>
    </condition>


    <condition id="alt aes condition">
      <description>Enable aes_alt implementation</description>
      <require Cclass="Security" Cgroup="STFCF" Csub="MbedTLS Alt HAL"/>
    </condition>
    <condition id="alt aes hal condition">
      <description>Enable aes_alt_hal implementation</description>
      <require Cclass="Security" Cgroup="STFCF" Csub="MbedTLS Alt HAL"/>
    </condition>
    <condition id="alt aes_aes hal condition">
      <description>Enable aes_alt_hal implementation based on AES IP</description>
      <require Cclass="Security" Cgroup="STFCF" Csub="MbedTLS Alt HAL"/>
    </condition>
    <condition id="alt cryp_aes hal condition">
      <description>Enable aes_alt_hal implementation based on CRYP IP</description>
      <deny Cclass="Security" Cgroup="STFCF" Csub="PSA API"/>
    </condition>
    <condition id="alt aes stlib condition">
      <description>Enable aes_alt_stlib implementation</description>
      <deny Cclass="Security" Cgroup="STFCF" Csub="PSA API"/>
    </condition>
    <condition id="alt ccm condition">
      <description>Enable ccm_alt implementation</description>
      <deny Cclass="Security" Cgroup="STFCF" Csub="PSA API"/>
        </condition>
    <condition id="alt ccm hal condition">
      <description>Enable ccm_alt_hal implementation</description>
      <deny Cclass="Security" Cgroup="STFCF" Csub="PSA API"/>
    </condition>
    <condition id="alt aes_ccm hal condition">
      <description>Enable ccm_alt_hal implementation based on AES IP</description>
      <deny Cclass="Security" Cgroup="STFCF" Csub="PSA API"/>
    </condition>
    <condition id="alt cryp_ccm hal condition">
      <description>Enable ccm_alt_hal implementation based on CRYP IP</description>
      <deny Cclass="Security" Cgroup="STFCF" Csub="PSA API"/>
    </condition>
    <condition id="alt ccm stlib condition">
      <description>Enable ccm_alt_stlib implementation</description>
      <deny Cclass="Security" Cgroup="STFCF" Csub="PSA API"/>
    </condition>
    <condition id="alt chachapoly condition">
      <description>Enable chachapoly_alt implementation</description>
      <!-- Works only with ALT STCryptoLib -->
      <deny Cclass="Security" Cgroup="STFCF" Csub="PSA API"/>
    </condition>
    <condition id="alt chachapoly stlib condition">
      <description>Enable chachapoly_alt_stlib implementation</description>
      <deny Cclass="Security" Cgroup="STFCF" Csub="PSA API"/>
    </condition>
    <condition id="alt gcm condition">
      <description>Enable gcm_alt implementation</description>
      <deny Cclass="Security" Cgroup="STFCF" Csub="PSA API"/>
        </condition>
    <condition id="alt gcm hal condition">
      <description>Enable gcm_alt_hal implementation</description>
      <deny Cclass="Security" Cgroup="STFCF" Csub="PSA API"/>
    </condition>
    <condition id="alt aes_gcm hal condition">
      <description>Enable gcm_alt_hal implementation based on AES IP</description>
      <deny Cclass="Security" Cgroup="STFCF" Csub="PSA API"/>
    </condition>
    <condition id="alt cryp_gcm hal condition">
      <description>Enable gcm_alt_hal implementation based on CRYP IP</description>
      <deny Cclass="Security" Cgroup="STFCF" Csub="PSA API"/>
    </condition>
    <condition id="alt gcm stlib condition">
      <description>Enable gcm_alt_stlib implementation</description>
      <deny Cclass="Security" Cgroup="STFCF" Csub="PSA API"/>
    </condition>
    <condition id="alt cmac condition">
      <description>Enable cmac_alt implementation</description>
      <deny Cclass="Security" Cgroup="STFCF" Csub="PSA API"/>
    </condition>
    <condition id="alt cmac stlib condition">
      <description>Enable cmac_alt_stlib implementation</description>
      <deny Cclass="Security" Cgroup="STFCF" Csub="PSA API"/>
    </condition>
    <condition id="alt drbg condition">
      <description>Enable drbg_alt implementation</description>
      <deny Cclass="Security" Cgroup="STFCF" Csub="PSA API"/>
    </condition>
    <condition id="alt drbg stlib condition">
      <description>Enable drbg_alt_stlib implementation</description>
      <deny Cclass="Security" Cgroup="STFCF" Csub="PSA API"/>
    </condition>
    <condition id="alt entropy_hw condition">
      <description>Enable entropy_hw_alt implementation</description>
      <!-- Works only with ALT HAL -->
      <require Cclass="Security" Cgroup="STFCF" Csub="MbedTLS Alt HAL"/>
    </condition>
    <condition id="alt rsa condition">
      <description>Enable rsa_alt implementation</description>
      <deny Cclass="Security" Cgroup="STFCF" Csub="PSA API"/>
        </condition>
    <condition id="alt rsa hal condition">
      <description>Enable rsa_alt_hal implementation</description>
      <deny Cclass="Security" Cgroup="STFCF" Csub="PSA API"/>
    </condition>
    <condition id="alt rsa stlib condition">
      <description>Enable rsa_alt_stlib implementation</description>
      <deny Cclass="Security" Cgroup="STFCF" Csub="PSA API"/>
    </condition>
    <condition id="alt ecp hal condition">
      <description>Enable ecp_alt implementation</description>
      <accept condition="alt ecdh hal condition"/>
      <accept condition="alt ecdsa hal condition"/>
    </condition>
    <condition id="alt ecdh condition">
      <description>Enable ecdh_alt implementation</description>
      <deny Cclass="Security" Cgroup="STFCF" Csub="PSA API"/>
        </condition>
    <condition id="alt ecdh hal condition">
      <description>Enable ecdh_alt_hal implementation</description>
      <deny Cclass="Security" Cgroup="STFCF" Csub="PSA API"/>
    </condition>
    <condition id="alt ecdh stlib condition">
      <description>Enable ecdh_alt_stlib implementation</description>
      <deny Cclass="Security" Cgroup="STFCF" Csub="PSA API"/>
    </condition>
    <condition id="alt ecdsa condition">
      <description>Enable ecdsa_alt implementation</description>
      <require Cclass="Security" Cgroup="STFCF" Csub="MbedTLS Alt HAL"/>
    </condition>
    <condition id="alt ecdsa hal condition">
      <description>Enable ecdsa_alt_hal implementation</description>
      <require Cclass="Security" Cgroup="STFCF" Csub="MbedTLS Alt HAL"/>
    </condition>
    <condition id="alt ecdsa stlib condition">
      <description>Enable ecdsa_alt_stlib implementation</description>
      <deny Cclass="Security" Cgroup="STFCF" Csub="PSA API"/>
    </condition>
    <condition id="alt sha1 condition">
      <description>Enable sha1_alt implementation</description>
      <!-- Works only with ALT HAL -->
      <deny Cclass="Security" Cgroup="STFCF" Csub="PSA API"/>
    </condition>
    <condition id="alt sha1 hal condition">
      <description>Enable sha1_alt_hal implementation</description>
      <deny Cclass="Security" Cgroup="STFCF" Csub="PSA API"/>
    </condition>
    <condition id="alt sha256 condition">
      <description>Enable sha256_alt implementation</description>
      <require Cclass="Security" Cgroup="STFCF" Csub="MbedTLS Alt HAL"/>
    </condition>
    <condition id="alt sha256 hal condition">
      <description>Enable sha256_alt_hal implementation</description>
      <require Cclass="Security" Cgroup="STFCF" Csub="MbedTLS Alt HAL"/>
    </condition>
    <condition id="alt sha256 stlib condition">
      <description>Enable sha256_alt_stlib implementation</description>
      <deny Cclass="Security" Cgroup="STFCF" Csub="PSA API"/>
    </condition>
    <condition id="alt sha512 condition">
      <description>Enable sha512_alt implementation</description>
      <deny Cclass="Security" Cgroup="STFCF" Csub="PSA API"/>
        </condition>
    <condition id="alt sha512 hal condition">
      <description>Enable sha512_alt_hal implementation</description>
      <deny Cclass="Security" Cgroup="STFCF" Csub="PSA API"/>
    </condition>
    <condition id="alt sha512 stlib condition">
      <description>Enable sha512_alt_stlib implementation</description>
      <deny Cclass="Security" Cgroup="STFCF" Csub="PSA API"/>
    </condition>
  </conditions>

  <components>
    <component generator="stfcf_mx2codegen" Cclass="Security" Cgroup="STM32CubeMX2 Config" Csub="STFCF" Cversion="1.1.0" condition="STFCF config condition">
      <description>TO BE DEFINED</description>
      <files>
        <file category="header" name="mx_mbedtls_alt_config.h" />
        <file category="header" name="mx_mbedtls_config.h" />
        <file category="header" name="mx_stfcf_config.h" />
        <file category="other" name="mx_stfcf_license.md" />
      </files>
    </component>
    
    <!-- Mbed TLS ALT Common -->
    <component Cclass="Security" Cgroup="STFCF" Csub="MbedTLS Alt Common" Cversion="1.0.0">
      <description>Router for the Mbed TLS and STMicroelectronics' alternatives according to the configuration choices</description>
      <files>
        <file category="include" name="../../../../../../../../middleware/stfcf/mbedtls_alt/include/common/"/>
        <file category="header" name="../../../../../../../../middleware/stfcf/mbedtls_alt/include/common/aes_alt.h" condition="alt aes condition"/>
        <file category="header" name="../../../../../../../../middleware/stfcf/mbedtls_alt/include/common/ccm_alt.h" condition="alt ccm condition"/>
