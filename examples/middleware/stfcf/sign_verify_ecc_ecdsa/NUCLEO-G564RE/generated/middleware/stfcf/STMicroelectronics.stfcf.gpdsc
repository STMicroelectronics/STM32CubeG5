        <file category="header" name="../../../../../../../../middleware/stfcf/mbedtls_alt/include/common/rsa_alt.h" condition="alt rsa condition"/>
        <file category="header" name="../../../../../../../../middleware/stfcf/mbedtls_alt/include/common/sha1_alt.h" condition="alt sha1 condition"/>
        <file category="header" name="../../../../../../../../middleware/stfcf/mbedtls_alt/include/common/sha256_alt.h" condition="alt sha256 condition"/>
        <file category="header" name="../../../../../../../../middleware/stfcf/mbedtls_alt/include/common/sha512_alt.h" condition="alt sha512 condition"/>
      </files>
    </component>

    <!-- Mbed TLS ALT HAL -->
    <component Cclass="Security" Cgroup="STFCF" Csub="MbedTLS Alt HAL" Cversion="1.0.1" condition="Mbed TLS Alt HAL condition">
      <description>Mbed TLS alternative implementation thanks hardware acceleration (HAL API)</description>
      <files>
        <file category="header" name="../../../../../../../../middleware/stfcf/mbedtls_alt/include/hal/hal_aes_alt.h" condition="alt aes hal condition"/>
