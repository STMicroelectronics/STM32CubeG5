<?xml version="1.0" encoding="UTF-8"?>
<Root xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="SCHVerif.xsd">
<McubootFormat>
    <GlobalParam>
        <Command>sign</Command>
        <Title>Data image generation</Title>
        <LinkedXML>..\stirot\stirot_config.xml</LinkedXML>
    </GlobalParam>
    <Param>
        <Name>Image magic</Name>
        <Type>Data</Type>
        <Command>-ma</Command>
        <Hidden>1</Hidden>
        <Default>0x55f7394e</Default>
    </Param>
    <Param>
        <Name>Endianness</Name>
        <Type>Data</Type>
        <Command>-e</Command>
        <Hidden>1</Hidden>
        <Default>little</Default>
    </Param>
    <Param>
        <Name>Data image installation slot size in HDPL2 OBKeys</Name>
        <Link />
        <Type>Data</Type>
        <Command>-S</Command>
        <Hidden>1</Hidden>
        <Default />
    </Param>
    <Param>
        <Name>Header Size</Name>
        <Type>Data</Type>
        <Command>-H</Command>
        <Hidden>1</Hidden>
        <Default>0x20</Default>
    </Param>
    <Param>
        <Name>Padding Header</Name>
        <Type>Data</Type>
        <Command>--pad-header</Command>
        <Hidden>1</Hidden>
        <Default />
    </Param>
    <Param>
        <Name>Version</Name>
        <Value>1.0.0</Value>
        <Type>Data</Type>
        <Command>-v</Command>
        <Tooltip>Version of the data binary. Format is x.y.z</Tooltip>
        <Default>1.0.0</Default>
    </Param>
    <Param>
        <Name>Security version</Name>
        <Value>auto</Value>
        <Type>Data</Type>
        <Command>-s</Command>
        <Hidden>1</Hidden>
        <Tooltip>Value of Security version on which antirollback feature is relying.
        'auto' (default) : Security version value is automatically aligned to image version.
        '32 bits value': Security version value manually selected (not aligned with image version).
        Antirollback feature is inactive if Security version value remains unchanged at each version of image.
        </Tooltip>
        <Default>auto</Default>
    </Param>
    <Param>
        <Name>Installation mode</Name>
        <Type>Data</Type>
        <Command>--overwrite-only</Command>
        <Hidden>1</Hidden>
        <Default />
    </Param>
    <Param>
        <Name>Align</Name>
        <Type>Data</Type>
        <Command>--align</Command>
        <Hidden>1</Hidden>
        <Default>16</Default>
    </Param>
    <Param>
        <Name>Data binary input file</Name>
        <Value>..\..\bin\appli\appli_data.bin</Value>
        <Type>File</Type>
        <Tooltip>Select the data binary file to be processed for the image generation</Tooltip>
        <Default>appli_data.bin</Default>
    </Param>
    <Output>
        <Name>Image output file</Name>
        <Value>..\..\bin\appli\appli_data_provisioning_sign.bin</Value>
        <Default>appli_data_provisioning_sign.bin</Default>
    </Output>
</McubootFormat>
</Root>
