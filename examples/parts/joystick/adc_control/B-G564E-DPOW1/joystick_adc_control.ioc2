"File: joystick_adc_control.csolution.yml" = """
# yaml-language-server: $schema=https://raw.githubusercontent.com/Open-CMSIS-Pack/devtools/schemas/projmgr/2.11.0/tools/projmgr/schemas/csolution.schema.json
solution:
  target-types:
    - type: B-G564E-DPOW1
      board: B-G564E-DPOW1:BG564EDPOW1$CR1
      device: STM32G564REZ3
  output-dirs:
    tmpdir: build/tmp
    outdir: $SolutionDir()$/build/$Project$.$BuildType$
  generators:
    base-dir: $ProjectDir()$/generated
    options:
      - generator: stm32g5xx_hal_mx2codegen
        path: $SolutionDir()$/../generated/hal/
      - generator: syscalls_mx2codegen
        path: $SolutionDir()$/../generated/utilities/syscalls
      - generator: joystick_mx2codegen
        path: $SolutionDir()$/../generated/parts/joystick
      - generator: led_mx2codegen
        path: $SolutionDir()$/../generated/parts/led
      - generator: basic_stdio_mx2codegen
        path: $SolutionDir()$/../generated/utilities/basic_stdio
  build-types:
    - type: debug_GCC
      compiler: GCC
    - type: release_GCC
      compiler: GCC
    - type: debug_IAR
      compiler: IAR
    - type: release_IAR
      compiler: IAR
    - type: debug_AC6
      compiler: AC6
    - type: release_AC6
      compiler: AC6
  projects:
    - project: project/joystick_adc_control.cproject.yml
  packs:
    - pack: STMicroelectronics::b-g564e-dpow1_hw-board@2.0.0
    - pack: STMicroelectronics::basic_stdio@2.1.0
    - pack: STMicroelectronics::CMSIS@6.3.0
    - pack: STMicroelectronics::esd_hw-part@2.2.0
    - pack: STMicroelectronics::joystick_hw-part@2.2.0
    - pack: STMicroelectronics::joystick_part_drivers@2.0.0
    - pack: STMicroelectronics::led_hw-part@2.5.0
    - pack: STMicroelectronics::led_part_drivers@2.2.0
    - pack: STMicroelectronics::st-link_hw-part@2.1.0
    - pack: STMicroelectronics::stm32g5xx_dfp@2.0.0
    - pack: STMicroelectronics::stm32g5xx_hal_drivers@2.0.0
    - pack: STMicroelectronics::syscalls@2.0.2
    - pack: STMicroelectronics::tcpp03-m20_hw-part@2.1.0
"""
