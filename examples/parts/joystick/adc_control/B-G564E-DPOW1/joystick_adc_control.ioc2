            - --inline
            - --map=$Project$.$BuildType$+$TargetType$.map
          Link-CPP:
            - --skip_dynamic_initialization
            - --inline
            - --map=$Project$.$BuildType$+$TargetType$.map
      for-context:
        - .release_IAR
    - setup: release_GCC
      misc:
        - ASM:
