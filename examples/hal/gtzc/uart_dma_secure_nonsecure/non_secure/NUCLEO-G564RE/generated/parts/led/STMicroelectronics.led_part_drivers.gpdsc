<?xml version="1.0" encoding="UTF-8"?>
<package xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" schemaVersion="1.7.55" xsi:noNamespaceSchemaLocation="PACK.xsd">
  <vendor>STMicroelectronics</vendor>
  <name>led_part_drivers</name>
  <url>https://developer.st.com/st-pack-server/api/v1/pack/</url>
  <releases>
    <release version="0.0.1" date="2024-07-17">First GPDSC template Model Release</release>
  </releases>
  <conditions>
    <condition id="LED CFG Condition">
      <description>STMicroelectronics configuration for LED part driver</description>
      <require Cclass="Board Part" Cgroup="LED" Csub="GPIO"/>
    </condition>
  </conditions>
  <components>
    <component Cclass="Board Part" Cgroup="Config" Csub="LED" Cversion="1.1.0" condition="LED CFG Condition">
      <description>LED part driver configuration</description>
      <files>
        <file category="header" name="mx_led.h"/>
      </files>
    </component>
  </components>
</package>
